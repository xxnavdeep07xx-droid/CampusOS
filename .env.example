# ─────────────────────────────────────────────────────────────
# CampusOS — environment variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local or any file containing real keys.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role / secret key (SERVER ONLY — never expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for invite links + QR codes.
# Production: https://your-domain.com   Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Google Drive integration (teacher file import/export).
# Leave blank to disable the Google Drive features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback
